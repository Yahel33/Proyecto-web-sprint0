doctype html
html(lang=locale)
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    block title
      title= __('admin.defaultTitle')
    meta(name='description', content=typeof description !== 'undefined' ? description : __('admin.defaultDescription'))
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet', href='/css/stride.css')
  body
    aside.admin-sidebar
      .brand.text-white.px-3.mb-3
        | STRIDE
        span -CO
      .sidebar-label.text-uppercase.tiny.px-3.mb-3= __('admin.sidebar.label')
      -
        var navItems = [
          { path: '/admin', icon: 'bi-grid', label: __('admin.nav.dashboard'), resource: null },
          { path: '/admin/products', icon: 'bi-box-seam', label: __('admin.nav.products'), resource: 'products' },
          { path: '/admin/variants', icon: 'bi-tags', label: __('admin.nav.variants'), resource: 'variants' },
          { path: '/admin/inventory', icon: 'bi-stack', label: __('admin.nav.inventory'), resource: 'inventory' },
          { path: '/admin/orders', icon: 'bi-receipt', label: __('admin.nav.orders'), resource: 'orders' },
          { path: '/admin/customers', icon: 'bi-people', label: __('admin.nav.customers'), resource: 'customers' },
          { path: '/admin/users', icon: 'bi-person-badge', label: __('admin.nav.users'), resource: 'users' },
          { path: '/admin/roles', icon: 'bi-key', label: __('admin.nav.roles'), resource: 'roles' }
        ];
      nav.nav.flex-column
        each item in navItems
          if !item.resource || can(item.resource, 'read', 'any')
            a.nav-link(class=currentPath === item.path ? 'active' : '', href=item.path)
              i.bi.me-2(class=item.icon)
              = item.label
      .mt-4.px-2
        a.btn.btn-outline-light.w-100.btn-sm(href='/')
          i.bi.bi-shop.me-1
          = __('admin.nav.backToStore')
    main.admin-main
      .admin-top
        div
          .tiny= __('admin.breadcrumb')
          h2.fw-bold.mb-0= typeof pageTitle !== 'undefined' ? pageTitle : ''
        .d-flex.align-items-center.gap-2
          include ../partials/langSwitch
          if user
            span.pill
              i.bi.bi-person-circle
              = ' ' + user.firstName
            form.d-inline(method='POST', action='/logout')
              button.btn.btn-outline-secondary.btn-sm(type='submit')
                = __('admin.nav.logout') + ' '
                i.bi.bi-box-arrow-right
      include ../partials/flash
      block content
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    block scripts
