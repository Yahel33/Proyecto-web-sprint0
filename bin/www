#!/usr/bin/env node

/**
 * Module dependencies.
 */

var app = require('../app');
var debug = require('debug')('stride-co:server');
var http = require('http');
var config = require('config');
var sequelize = require('../config/sequelize');
var { connectMongo } = require('../config/mongoose');
require('../models/sql');
require('../models/mongo');

/**
 * Get port from environment and store in Express.
 */

var port = normalizePort(config.get('server.port'));
app.set('port', port);

/**
 * Create HTTP server.
 */

var server = http.createServer(app);

/**
 * Listen on provided port, on all network interfaces.
 */

Promise.all([sequelize.sync(), connectMongo()]).then(function () {
  console.log('App conectada a ' + sequelize.config.database + ' (' + config.util.getEnv('NODE_ENV') + ')');
  server.listen(port);
  server.on('error', onError);
  server.on('listening', onListening);
}).catch(function (err) {
  console.error('No se pudo conectar a las bases de datos:', err.message);
  process.exit(1);
});

/**
 * Normalize a port into a number, string, or false.
 */

function normalizePort(val) {
  var port = parseInt(val, 10);

  if (isNaN(port)) {
    // named pipe
    return val;
  }

  if (port >= 0) {
    // port number
    return port;
  }

  return false;
}

/**
 * Event listener for HTTP server "error" event.
 */

function onError(error) {
  if (error.syscall !== 'listen') {
    throw error;
  }

  var bind = typeof port === 'string'
    ? 'Pipe ' + port
    : 'Port ' + port;

  // handle specific listen errors with friendly messages
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

/**
 * Event listener for HTTP server "listening" event.
 */

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string'
    ? 'pipe ' + addr
    : 'port ' + addr.port;
  debug('Listening on ' + bind);
}
