doctype html
html(lang=locale)
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    block title
      title= typeof title !== 'undefined' ? title : __('store.defaultTitle')
    meta(name='description', content=typeof description !== 'undefined' ? description : __('store.defaultDescription'))
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css')
    link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css')
    link(rel='stylesheet', href='/css/stride.css')
  body
    header.store-header
      .container.py-2.d-flex.justify-content-between.align-items-center.gap-3
        a.brand.text-decoration-none.text-dark(href='/')
          | STRIDE
          span -CO
          small.d-block.fw-normal.text-secondary(style='font-size:.59rem;letter-spacing:2px')= __('layout.tagline')
        nav.store-nav.d-flex.align-items-center
          a(href='/', class=currentPath === '/' ? 'active' : '')= __('layout.nav.home')
          a(href='/products', class=currentPath.startsWith('/products') ? 'active' : '')= __('layout.nav.catalog')
          a(href='/my/orders', class=currentPath.startsWith('/my/orders') ? 'active' : '')= __('layout.nav.orders')
          a(href='/cart', class=currentPath.startsWith('/cart') ? 'active' : '')
            i.bi.bi-bag
            = ' ' + __('layout.nav.cart')
        .d-flex.align-items-center.gap-2
          include ../partials/langSwitch
          if user
            span.pill
              i.bi.bi-person-circle
              = ' ' + user.firstName
            form.d-inline(method='POST', action='/logout')
              button.btn.btn-outline-dark.btn-sm(type='submit')= __('layout.nav.logout')
          else
            a.btn.btn-outline-dark.btn-sm(href='/login')
              i.bi.bi-shield-lock.me-1
              = __('layout.nav.adminAccess')
    include ../partials/flash
    block content
    footer.shop-footer.py-5
      .container.d-flex.justify-content-between.flex-wrap.gap-2
        strong.fs-4 STRIDE-CO
        div= __('layout.footer.links')
        small= __('layout.footer.rights')
    script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    block scripts
